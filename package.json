{
  "name": "vercel-deploy-scripts",
  "version": "0.0.0",
  "description": "Shared deployment and security tooling for Firebase + Next.js projects hosted on Vercel",
  "license": "MIT",
  "bin": {
    "generate-local-env": "./scripts/generate-local-env.sh",
    "secrets-check": "./scripts/secrets-check.sh",
    "sync-env": "./dist/sync-env.js"
  },
  "files": [
    "scripts/",
    "dist/",
    ".gitleaks.toml"
  ],
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/sync-env.js",
    "test": "bats tests/bats/",
    "test:ts": "vitest run",
    "lint": "eslint --max-warnings 0 .",
    "prepare": "husky"
  },
  "dependencies": {
    "js-yaml": "^5.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^3.0.0",
    "bats": "github:bats-core/bats-core#v1.11.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  }
}
