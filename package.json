{
  "name": "vercel-deploy-scripts",
  "version": "0.0.0",
  "description": "Shared deployment and security tooling for Firebase + Next.js projects hosted on Vercel",
  "license": "MIT",
  "bin": {
    "generate-local-env": "./scripts/generate-local-env.sh",
    "init-terraform": "./scripts/init-terraform.sh",
    "secrets-check": "./scripts/secrets-check.sh",
    "sync-env": "./dist/sync-env.js"
  },
  "files": [
    "scripts/",
    "dist/",
    ".gitleaks.toml",
    "templates/"
  ],
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/sync-env.js",
    "prepare": "tsc && chmod +x dist/sync-env.js",
    "test": "bats tests/bats/",
    "test:ts": "vitest run"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "bats": "github:bats-core/bats-core#v1.11.1",
    "semantic-release": "^25.0.3",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
